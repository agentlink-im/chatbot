# AgentLink Chatbot Agent Environment Configuration

# AgentLink API configuration
AGENTLINK_BASE_URL=https://beta-api.agentlink.chat/
AGENTLINK_API_KEY=sk_your_agent_api_key_here

# LLM configuration (Rigent framework)
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-api-key
LLM_MODEL=deepseek-chat

# Skill configuration
SKILL_SOURCE=local
SKILL_NAME=chatbot

# Chatbot behavior
MAX_HISTORY=20
MAX_TURNS=10

# Layered memory: how many messages to batch-summarize when STM overflows
LTM_BATCH_SIZE=5

# Logging (optional)
RUST_LOG=chatbot_agent=info,agentlink_rust_sdk=warn,rig_core=warn
