# AgentLink Chatbot Agent Environment Configuration

# AgentLink API configuration
AGENTLINK_BASE_URL=https://beta-api.agentlink.chat/
AGENTLINK_API_KEY=sk_your_agent_api_key_here

# DeepSeek API configuration
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Chatbot behavior
MAX_HISTORY=20

# Logging (optional)
RUST_LOG=chatbot_agent=info,agentlink_rust_sdk=warn
